#usda 1.0
(
    defaultPrim = "Table"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Table" (
    doc = "Reference-inspired table: 1.20 x 0.60 m; top surface 0.75 m. Original procedural geometry, no external assets. Static collision geometry."
)
{
    def "Looks"
    {
        def Material "BlackFrame"
        {
            token outputs:surface.connect = </Table/Looks/BlackFrame/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.021, 0.023)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

