over "World"
{
    over "Table" (
        references = @../assets/objects/wood_frame_table_rtx.usda@
    )
    {
        over "WoodGrain" (
            active = false
        )
        {
        }
    }

    over "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
    }

    over "TableOverview"
    {
        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -5.124195658716535)
        token visibility = "inherited"
        matrix4d xformOp:transform = ( (0.8002572339512533, 0.5996568681410098, -5.730008481585891e-17, 0), (-0.2282129617158744, 0.3045559605791474, 0.9247510535168787, 0), (0.5545333205620314, -0.7400387201809259, 0.3805725804881619, 0), (2.7369822572623423, -3.5199045362273784, 2.597134829194206, 1.0000000000000002) )
    }

