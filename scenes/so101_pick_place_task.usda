            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )

        over "base_link"
        {
        }

        over "shoulder_link"
        {
        }

        over "upper_arm_link"
        {
        }

        over "lower_arm_link"
        {
        }

        over "wrist_link"
        {
        }

        over "gripper_link"
        {
            def Cube "fixed_finger_collision" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                double size = 1
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </World/TaskObjects/GraspContactMaterial>
                double3 xformOp:scale = (0.012, 0.014, 0.065)
                double3 xformOp:translate = (-0.006, 0, -0.073)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        over "moving_jaw_so101_v1_link"
        {
            def Cube "moving_finger_collision" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                double size = 1
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </World/TaskObjects/GraspContactMaterial>
                double3 xformOp:scale = (0.014, 0.065, 0.014)
                double3 xformOp:translate = (0, -0.050, 0.019)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        over "gripper_frame_link"
        {
        }

        over "joints"
        {
            over "shoulder_pan"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "shoulder_lift"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "elbow_flex"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_flex"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_roll"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "gripper"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }
    }

