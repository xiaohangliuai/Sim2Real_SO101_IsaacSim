#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.2157279667852776, -1.4866279949225643, 2.2200915638487695)
                double3 target = (0, 0, 0.7501000165939333)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (-0.2675810960676957, 0.23691277560148388, 5)
                double radius = 1.8510034561157227
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./so101_table_mounted_fixed.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./so101_table_mounted.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Table" (
        references = @../assets/objects/wood_frame_table_rtx.usda@
    )
    {
        over "WoodGrain" (
            active = false
        )
        {
        }
    }

    over "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
    }

    over "TableOverview"
    {
        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -5.124195658716535)
        token visibility = "inherited"
        matrix4d xformOp:transform = ( (0.8002572339512533, 0.5996568681410098, -5.730008481585891e-17, 0), (-0.2282129617158744, 0.3045559605791474, 0.9247510535168787, 0), (0.5545333205620314, -0.7400387201809259, 0.3805725804881619, 0), (2.7369822572623423, -3.5199045362273784, 2.597134829194206, 1.0000000000000002) )
    }

    over "so101_new_calib"
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )
    }
}

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                rel camera = </OmniverseKit_Persp>
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 720)
            }
        }
    }
}

